<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18.0" prefWidth="560.0" prefHeight="430.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.practicahilosjavafx.ProcesadorController">
    <padding>
        <Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/>
    </padding>

    <Label text="Monitor de procesos empresariales"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <VBox spacing="8.0" maxWidth="Infinity">
        <Label text="Procesamiento de clientes (100 registros)"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label fx:id="estadoClientes" text="Listo para iniciar"/>
        <ProgressBar fx:id="progresoClientes" progress="0.0" maxWidth="Infinity"/>
        <Label fx:id="porcentajeClientes" text="0%"/>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="iniciarClientes" text="Iniciar clientes"
                    onAction="#iniciarClientes"/>
            <Button fx:id="detenerClientes" text="Detener clientes"
                    onAction="#detenerClientes" disable="true"/>
            <Button fx:id="reiniciarClientes" text="Reiniciar"
                    onAction="#reiniciarClientes"/>
        </HBox>
    </VBox>

    <VBox spacing="8.0" maxWidth="Infinity">
        <Label text="Procesamiento de productos (50 registros)"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label fx:id="estadoProductos" text="Listo para iniciar"/>
        <ProgressBar fx:id="progresoProductos" progress="0.0" maxWidth="Infinity"/>
        <Label fx:id="porcentajeProductos" text="0%"/>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="iniciarProductos" text="Iniciar productos"
                    onAction="#iniciarProductos"/>
            <Button fx:id="detenerProductos" text="Detener productos"
                    onAction="#detenerProductos" disable="true"/>
            <Button fx:id="reiniciarProductos" text="Reiniciar"
                    onAction="#reiniciarProductos"/>
        </HBox>
    </VBox>
</VBox>
